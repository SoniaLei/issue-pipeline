# Copy to .env and fill in. Nothing here is read from issue or PR content.

# GitHub App webhook secret. Required.
GITHUB_WEBHOOK_SECRET=change-me

# Repositories the pipeline will act on. Events for anything else are dropped.
REPO_ALLOWLIST=SoniaLei/superset-cognition-demo

# Logins whose approval label authorizes spend. Nobody else's does.
MAINTAINER_ALLOWLIST=SoniaLei

APPROVAL_LABEL=devin-ready
DATABASE_PATH=data/pipeline.db
# Raw webhook deliveries are kept this long for replay and audit (D-014); the
# worker drops older bodies hourly, keeping the id for deduplication. 0 keeps
# them forever.
DELIVERY_RETENTION_DAYS=30
# Worker claim lease; an expired lease is reclaimed by another worker (D-013).
LEASE_SECONDS=120
# Shared operator token for /dashboard, /api/* and /report*. Browsers use HTTP
# Basic (any username, the token as password); scripts send
# "Authorization: Bearer <token>". /webhooks/github (HMAC-signed) and /health
# stay open. Required when DEVIN_MODE=live; generate with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DASHBOARD_TOKEN=
# Interface compose and scripts/run_live.sh listen on. Local-only by default;
# anything else needs DASHBOARD_TOKEN.
# BIND_ADDRESS=127.0.0.1

# GitHub reconciliation (D-041). off: the service learns GitHub state only
# from webhooks. live: the worker also re-reads every active run's issue and
# PR from the GitHub API on an interval and once at startup, and replays what
# the webhooks missed through the same intake. Read-only: the token needs
# Issues, Pull requests, Checks and Contents/Metadata *read* on the allowlisted
# repositories (an App installation token or a fine-grained token). It can
# never merge, push, approve or deploy, whatever its scopes; the code has no
# such call. Token via the secret manager, never in this file.
GITHUB_MODE=off
GITHUB_API_BASE=https://api.github.com
# GITHUB_TOKEN=
RECONCILE_INTERVAL_SECONDS=300

# sim keeps everything in-process and spends nothing.
DEVIN_MODE=sim
# DEVIN_API_BASE=https://api.devin.ai
# DEVIN_ORG_ID=
# DEVIN_API_TOKEN=            # dedicated service user, not a personal token
# DEVIN_PLAYBOOK_ID=
# Empty means no org secrets are granted to the session. Omitting the variable
# is not the same as omitting the API field, which would grant all of them.
DEVIN_SECRET_IDS=

# fake records messages instead of sending them.
SLACK_MODE=fake
# webhook: incoming webhooks, top-level messages only.
# bot:     Web API with a bot token; later PR events thread under the run's
#          "PR opened" post and react to it (D-036). Scopes: chat:write,
#          reactions:write. Invite the bot to each channel.
SLACK_TRANSPORT=webhook
# webhook transport: destination key = secret webhook URL, one per authorized channel
SLACK_DESTINATIONS=engineering-updates=https://example.invalid/hook,automation-alerts=https://example.invalid/hook
# bot transport: destination key = channel id (C...). Token via the secret
# manager, never in this file.
# SLACK_BOT_TOKEN=
# SLACK_CHANNELS=engineering-updates=C...,automation-alerts=C...
# optional per-repository routing; falls back to DEFAULT_DESTINATION
REPO_DESTINATIONS=
DEFAULT_DESTINATION=engineering-updates
OPERATOR_DESTINATION=automation-alerts

# Budget. The ACU ceiling is set at session creation and cannot be changed
# afterwards; it is the only hard spend control there is.
MAX_ACU_LIMIT=20
MAX_CONCURRENT_RUNS=2
MAX_DAILY_SESSIONS=10
RUN_MAX_SECONDS=14400
NO_OUTPUT_GRACE_SECONDS=300

# Devin Review gate (D-033). The worker asks Devin Review for each PR head once
# and reads its progress from the pr-reviews API; the verdict (clear / N
# findings) is the bot's review on GitHub for that exact commit.
#   required  - verified = checks passed AND review clear, both on the current head
#   advisory  - review is requested and shown, verified = checks passed
#   off       - no review calls, verified = checks passed
# The service user needs read access to pr-reviews in the org (same token).
REVIEW_GATE_MODE=required
# Seconds between reads of one head's review status.
REVIEW_POLL_SECONDS=60
# Consecutive provider errors before a head is marked "unavailable" and
# surfaces in Needs attention. A new head starts the count again.
REVIEW_MAX_ATTEMPTS=5

# Devin analytics (session insights, daily consumption, org PR/session counts).
# Read by the worker, stored beside runs, never applied to them.
ANALYTICS_ENABLED=true
INSIGHTS_REFRESH_SECONDS=600
INSIGHTS_SETTLE_SECONDS=86400
METRICS_REFRESH_SECONDS=300
